{
  "name": "atto",
  "version": "0.1.0",
  "description": "Agent-first, snapshot-guarded file editing: a headless binary and a pi extension.",
  "keywords": ["pi-package", "agent", "editing"],
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": ["./tools/atto/pi/atto.ts"],
    "skills": ["./.agents/skills/atto"]
  },
  "scripts": {
    "test:guard": "node --experimental-strip-types --test tools/atto/pi/guard.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "tools/atto/pi",
    "tools/atto/*.go",
    "tools/atto/go.mod",
    "tools/atto/CONTRACT.md",
    "tools/atto/README.md",
    "tools/atto/bench",
    ".agents/skills/atto",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ]
}
