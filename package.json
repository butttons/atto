{
  "name": "atto",
  "version": "0.1.0",
  "description": "Agent-first, snapshot-guarded file editing: a headless binary and a pi extension.",
  "keywords": ["pi-package", "agent", "editing"],
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": ["./pi/atto.ts"],
    "skills": ["./.agents/skills/atto"]
  },
  "scripts": {
    "test:guard": "node --experimental-strip-types --test pi/guard.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "cmd",
    "internal",
    "go.mod",
    "CONTRACT.md",
    "bench",
    ".agents/skills/atto",
    "README.md",
    "AGENTS.md"
  ]
}
